rules_version = '2';

// PokéSurvivor security rules.
//   saves/{uid}            save: owner only
//   names/{nickname}       reservation of unique nicknames (lowercase)
//   profiles/{uid}         each player's public nickname
//   friendships/{a_b}      requests and friendships between two players
//   runs/{uid}             when your last run started (leaderboard anti-cheat)
//   lb/{table}/e/{id}      time-survived leaderboard
//   reports/{table__id__uid}  reports of suspicious records (only the admin reads them)
//   lbs/{table}            summary with the top 50 of each table
//   pres/{uid}             online (approximate) · inv/{to_from} invitations
//   chats/{a_b}            private chat between friends (last 25 messages)
// Everything else is closed.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    // Moderation (hidden screen in the game, js/ui/mod-ui.js): this account only.
    function admin() { return signedIn() && me() in ['Hn5Mdk51FGN9Rkj1BDMVcOvF1N53']; }

    // ---------- saved game ----------
    // Only its owner reads and writes it. Nobody is flagged automatically any more (14-10-2026:
    // the margins against impossible runs kept legitimate players off the
    // leaderboard). The only thing that removes someone from the leaderboard is an admin ban
    // (ban = true; the old "sus" field no longer counts for anything). The player can't
    // remove the ban themselves: if it is set, their saves must keep it.
    match /saves/{uid} {
      allow read, delete: if signedIn() && me() == uid;
      allow read: if admin();

      allow create: if signedIn() && me() == uid && validSaveDoc() && saneSave(request.resource.data.save)
        && request.resource.data.get('ban', false) == false;
      allow update: if signedIn() && me() == uid && validSaveDoc() && saneSave(request.resource.data.save)
        && request.resource.data.get('ban', false) == resource.data.get('ban', false);
      // The admin can only ban or unban (and remove the old flag).
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ban', 'sus'])
        && request.resource.data.get('ban', false) is bool;
    }

    function validSaveDoc() {
      return request.resource.data.keys().hasOnly(['save', 'updatedAt', 'v', 'sus', 'ban'])
        && request.resource.data.save is map
        && request.resource.data.v is int
        && request.resource.data.get('ban', false) is bool
        && request.resource.data.updatedAt == request.time;
    }
    function tk(s, k) { return s.get('tickets', {}).get(k, 0); }
    // Just that the numbers make sense (the game already cleans them on load).
    function saneSave(s) {
      return s.get('coins', 0) is number && s.get('coins', 0) >= 0
        && tk(s, 't1') is number && tk(s, 't1') >= 0
        && tk(s, 't10') is number && tk(s, 't10') >= 0;
    }

    // ---------- apodos ----------

    match /names/{lower} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == me()
        && lower.size() >= 3 && lower.size() <= 64
        && lower == lower.lower();
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // Public profile: nickname, 3 favourites, title, best records and medals.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && me() == uid
        && request.resource.data.keys().hasOnly(['name', 'lower', 'at', 'favs', 'title', 'banner', 'frame', 'best', 'medals'])
        && request.resource.data.name is string
        && request.resource.data.lower == request.resource.data.name.lower()
        && request.resource.data.at == request.time
        && (!('favs' in request.resource.data) || (request.resource.data.favs is list && request.resource.data.favs.size() <= 3))
        && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 40))
        && (!('banner' in request.resource.data) || (request.resource.data.banner is string && request.resource.data.banner.size() <= 16))
        && (!('frame' in request.resource.data) || (request.resource.data.frame is string && request.resource.data.frame.size() <= 16))
        && (!('best' in request.resource.data) || request.resource.data.best is map)
        && (!('medals' in request.resource.data) || (request.resource.data.medals is list && request.resource.data.medals.size() <= 8))
        && getAfter(/databases/$(database)/documents/names/$(request.resource.data.lower)).data.uid == me();
      allow delete: if signedIn() && me() == uid;
    }

    // ---------- amigos ----------
    // One document per pair, with id "lowerUid_higherUid".

    match /friendships/{pid} {
      allow read: if signedIn() && (resource == null || me() in resource.data.users);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['users', 'from', 'to', 'status', 'names', 'at'])
        && request.resource.data.from == me()
        && request.resource.data.to != me()
        && request.resource.data.status == 'pending'
        && request.resource.data.users.size() == 2
        && request.resource.data.users[0] < request.resource.data.users[1]
        && me() in request.resource.data.users
        && request.resource.data.to in request.resource.data.users
        && pid == request.resource.data.users[0] + '_' + request.resource.data.users[1]
        && request.resource.data.names is map
        && request.resource.data.at == request.time;
      // Only the recipient can accept it.
      allow update: if signedIn()
        && resource.data.to == me()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'at', 'names'])
        && request.resource.data.status == 'ok';
      // Either friend can change THEIR OWN name inside an accepted friendship (nickname change).
      allow update: if signedIn()
        && me() in resource.data.users
        && resource.data.status == 'ok'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['names'])
        && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([me()]);
      allow delete: if signedIn() && me() in resource.data.users;
    }

    // ---------- chat privado ----------
    // One document per pair of friends (same id as the friendship) with their last 25
    // messages and how far each one has read. Only between confirmed friends.
    function chatOk(pid, d) {
      return d.keys().hasOnly(['users', 'msgs', 'seen'])
        && d.users is list && d.users.size() == 2
        && d.users[0] < d.users[1]
        && me() in d.users
        && pid == d.users[0] + '_' + d.users[1]
        && d.msgs is list && d.msgs.size() <= 25
        && d.seen is map
        && get(/databases/$(database)/documents/friendships/$(pid)).data.status == 'ok';
    }
    // The last message is yours and reasonable (you can't put messages under your name in someone else's).
    function chatLastOk(d) {
      return d.msgs.size() == 0
        || (d.msgs[d.msgs.size() - 1].f == me()
            && d.msgs[d.msgs.size() - 1].t is string
            && d.msgs[d.msgs.size() - 1].t.size() <= 140
            && d.msgs[d.msgs.size() - 1].at is number
            && (!('c' in d.msgs[d.msgs.size() - 1]) || (d.msgs[d.msgs.size() - 1].c is string && d.msgs[d.msgs.size() - 1].c.size() <= 7)));
    }
    match /chats/{pid} {
      allow read: if signedIn() && (resource == null || me() in resource.data.users);
      allow create: if signedIn() && chatOk(pid, request.resource.data) && chatLastOk(request.resource.data);
      allow update: if signedIn() && me() in resource.data.users && chatOk(pid, request.resource.data)
        && (request.resource.data.msgs == resource.data.msgs || chatLastOk(request.resource.data));
      allow delete: if signedIn() && me() in resource.data.users;
    }

    // ---------- historial de partidas ----------
    // Copy of each player's latest runs so others can see them from their profile.
    // Only its owner writes it; anyone signed in reads it.
    match /histories/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['at', 'runs'])
        && request.resource.data.at == request.time
        && request.resource.data.runs is list && request.resource.data.runs.size() <= 100;
      allow delete: if signedIn() && me() == uid;
    }

    // ---------- ranking ----------

    // When each run starts (in a group, the host) the server records the time.
    match /runs/{uid} {
      allow read, delete: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['startedAt', 'mode'])
        && request.resource.data.startedAt == request.time;
    }

    // An entry can only improve, never get worse. Anti-cheat:
    //   - it can't last longer than the real time since your run started
    //     (runs/{uid}), with a 30 s margin; nor more than 2 h (raised from 1 h on
    //     21-10-2026: a legit run passed an hour in Arceus's Judgment and was refused)
    //   - level up to 20 + t/3 (the same limit the game itself uses, game.js clean(); it was 10 + t/4)
    //   - defeated up to 30 a second PER PLAYER (24-10-2026; it was 20 a second for the whole team:
    //     spawns now reach ~17/s solo and ~27/s in pairs by minute 30, so strong group runs were refused
    //     outright, in every table)
    //   - the account can't be banned by the admin (saves/{uid}.ban)
    function validEntry(board, id) {
      let d = request.resource.data;
      let run = get(/databases/$(database)/documents/runs/$(me())).data;
      return d.keys().hasOnly(['t', 'uids', 'names', 'dex', 'shiny', 'lv', 'kills', 'at'])
        && d.t is int && d.t > 0 && d.t <= 7200
        && d.t <= (request.time - run.startedAt).seconds() + 30
        && d.lv is int && d.lv >= 1 && d.lv <= 20 + d.t / 3
        && d.kills is int && d.kills >= 0 && d.kills <= 100 + d.t * 30 * d.uids.size()
        && get(/databases/$(database)/documents/saves/$(me())).data.get('ban', false) == false
        && d.uids is list && me() in d.uids
        && d.names is list && d.names.size() == d.uids.size()
        && d.dex is list && d.dex.size() == d.uids.size()
        && d.shiny is list && d.shiny.size() == d.uids.size()
        && d.at == request.time
        && (board.matches('s_.*|sk_.*|sl_.*')
              ? (d.uids.size() == 1 && id == me())
              : (d.uids.size() >= 2 && d.uids.size() <= 5 && id == d.uids.join('_')))
        && (resource == null || better(board, d, resource.data));
    }

    // Each table ranks by one number: kills (sk_ / gk_), level (sl_ / gl_, 25-10-2026) or time survived.
    function better(board, d, old) {
      return board.matches('sk_.*|gk_.*') ? d.kills > old.kills
        : board.matches('sl_.*|gl_.*') ? d.lv > old.lv
        : d.t > old.t;
    }
    function notMore(board, a, b) {
      return board.matches('sk_.*|gk_.*') ? a.kills <= b.kills
        : board.matches('sl_.*|gl_.*') ? a.lv <= b.lv
        : a.t <= b.t;
    }

    // Moderation (21-10-2026): the admin can add a VERIFIED run from a player's history that the
    // server refused at the time. Same shape and sanity limits as a normal record, minus the
    // "your own run, timed from its start" checks (it's added later, on someone else's behalf).
    function validAdminEntry(board, id) {
      let d = request.resource.data;
      return admin()
        && d.keys().hasOnly(['t', 'uids', 'names', 'dex', 'shiny', 'lv', 'kills', 'at'])
        && d.t is int && d.t > 0 && d.t <= 7200
        && d.lv is int && d.lv >= 1 && d.lv <= 20 + d.t / 3
        && d.kills is int && d.kills >= 0 && d.kills <= 100 + d.t * 30 * d.uids.size()
        && d.uids is list && d.uids.size() >= 1
        && d.names is list && d.names.size() == d.uids.size()
        && d.dex is list && d.dex.size() == d.uids.size()
        && d.shiny is list && d.shiny.size() == d.uids.size()
        && d.at == request.time
        && (board.matches('s_.*|sk_.*|sl_.*')
              ? (d.uids.size() == 1 && id == d.uids[0])
              : (d.uids.size() >= 2 && d.uids.size() <= 5 && id == d.uids.join('_')))
        && (resource == null || better(board, d, resource.data));
    }

    match /lb/{board}/e/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && (validEntry(board, id) || validAdminEntry(board, id));
      allow delete: if signedIn() && (me() in resource.data.uids || admin());
    }

    // Summary with the top 50 of each table (what is read when viewing the leaderboard).
    //   top: { id: { t, uids, names, dex, shiny, lv, kills } }
    //   me:  the row you add or improve (must match your validated record,
    //        written in the same transaction)
    //   ev:  the row that drops out of the top (only if it has less time than yours)
    // When deleting the account: me = '' and ev = one of your rows that is removed.
    function validTop(board) {
      let d = request.resource.data;
      let old = resource == null ? {} : resource.data.top;
      let changed = d.top.diff(old).affectedKeys();
      return d.keys().hasOnly(['top', 'me', 'ev'])
        && d.top is map && d.top.size() <= 50
        && d.me is string && d.ev is string
        && (d.me == '' ? (removeMine(d, old, changed) || adminRemove(d, old)) : addMine(board, d, old, changed));
    }
    // Moderation: the admin can only REMOVE rows from the top.
    function adminRemove(d, old) {
      return admin() && old.keys().hasAll(d.top.keys()) && d.top.diff(old).changedKeys().size() == 0;
    }
    function addMine(board, d, old, changed) {
      let e = getAfter(/databases/$(database)/documents/lb/$(board)/e/$(d.me)).data;
      let row = d.top[d.me];
      return (me() in e.uids || admin())
        && changed.hasOnly([d.me, d.ev])
        && row.t == e.t && row.uids == e.uids && row.names == e.names && row.dex == e.dex
        && (d.ev == '' || (!(d.ev in d.top) && d.ev in old
            && notMore(board, old[d.ev], e)));
    }
    function removeMine(d, old, changed) {
      return d.ev in old && me() in old[d.ev].uids && !(d.ev in d.top) && changed.hasOnly([d.ev]);
    }

    match /lbs/{board} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validTop(board);
    }

    // Approximate presence: "online" if at is from less than a few minutes ago.
    match /pres/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['at', 'room', 'play', 'on', 'act', 'since', 'mon'])
        && request.resource.data.at == request.time
        && request.resource.data.room is string && request.resource.data.room.size() <= 40
        && request.resource.data.play is bool && request.resource.data.on is bool
        && (!('act' in request.resource.data) || (request.resource.data.act is string && request.resource.data.act.size() <= 12))
        && (!('since' in request.resource.data) || request.resource.data.since is number)
        && (!('mon' in request.resource.data) || request.resource.data.mon is number);
      allow delete: if signedIn() && me() == uid;
    }

    // Room invitations: id "to_from". Only between confirmed friends.
    match /inv/{id} {
      allow read: if signedIn() && (resource == null || me() == resource.data.to || me() == resource.data.from);
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['to', 'from', 'room', 'name', 'at'])
        && request.resource.data.from == me()
        && id == request.resource.data.to + '_' + me()
        && request.resource.data.room is string && request.resource.data.room.size() <= 40
        && request.resource.data.name is string && request.resource.data.name.size() <= 16
        && request.resource.data.at == request.time
        && get(/databases/$(database)/documents/friendships/$(request.resource.data.to < me() ? request.resource.data.to + '_' + me() : me() + '_' + request.resource.data.to)).data.status == 'ok';
      allow delete: if signedIn() && (me() == resource.data.to || me() == resource.data.from);
    }

    // ---------- reportes ----------
    // One report per player and record (id "table__record__yourUid"). The admin reads and
    // deletes them from the hidden moderation screen.
    match /reports/{rid} {
      allow read, delete: if admin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['board', 'e', 'names', 't', 'by', 'at'])
        && request.resource.data.by == me()
        && request.resource.data.board is string && request.resource.data.board.size() <= 40
        && request.resource.data.e is string && request.resource.data.e.size() <= 160
        && request.resource.data.names is list && request.resource.data.names.size() <= 5
        && request.resource.data.t is int
        && request.resource.data.at == request.time
        && rid == request.resource.data.board + '__' + request.resource.data.e + '__' + me();
    }

    // To delete all your records when deleting the account (collection group query).
    match /{path=**}/e/{id} {
      allow read: if signedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
